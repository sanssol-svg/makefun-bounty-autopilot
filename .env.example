# Copy to ~/.makefun/ or set in your environment. NEVER commit real values.
# These are placeholders only — the real credentials stay on your server.

# Path to your make.fun credentials JSON (created by `makefun connect`)
# MAKEFUN_CRED=~/.makefun/credentials

# Path to your Solana keypair (from `makefun connect` / wallet)
# MAKEFUN_KEYPAIR=~/.makefun/sans-keypair.json

# Optional: override state / submissions file locations
# MAKEFUN_STATE=~/.makefun/bounty_state.json
# MAKEFUN_SUBS=~/.makefun/submissions.json
# MAKEFUN_BOARD=https://make.fun/api/competitions

# drand relay (timelock/anti-cheat anchor source)
MAKEFUN_DRAND=https://api.drand.sh
